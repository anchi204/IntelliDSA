generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  name String?
  email String? @unique
  emailVerified DateTime?
  image String?
  passwordHash String?
  preferredRevisionIntervalDays Int @default(4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  problems Problem[]
  accounts Account[]
  sessions Session[]
}
model Account {
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
  @@index([userId])
}
model Session {
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}
model Problem {
  id Int @id @default(autoincrement())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String
  platform String
  difficulty String
  topic String
  link String?
  solved Boolean @default(false)
  favorite Boolean @default(false)
  revisionEnabled Boolean @default(false)
  revisionDate DateTime?
  revisionCount Int @default(0)
  maxRevisions Int @default(0)
  revisionIntervalDays Int @default(4)
  solvedAt DateTime?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attempts ProblemAttempt[]
  revisions RevisionHistory[]
  @@index([userId])
  @@index([userId, solved])
  @@index([userId, revisionDate])
  @@index([userId, topic])
  @@index([userId, difficulty])
  @@index([userId, revisionEnabled, revisionDate])
}
model ProblemAttempt {
  id Int @id @default(autoincrement())
  problemId Int
  attemptedAt DateTime @default(now())
  solved Boolean @default(false)
  timeTaken Int?
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  @@index([problemId, attemptedAt])
}
model RevisionHistory {
  id Int @id @default(autoincrement())
  problemId Int
  revisedAt DateTime @default(now())
  revisionNumber Int
  result String
  nextRevisionDate DateTime?
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  @@index([problemId, revisedAt])
  @@index([problemId, result])
}